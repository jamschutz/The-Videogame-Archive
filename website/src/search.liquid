---
title: Search
layout: 'base.liquid'
includeScript: /code/search.js
---

<div class="Search-container">
    <!-- search bar -->
    <div class="Search-header">
        <div style="display: flex;">
            <input style="height: 30px" id="Global-searchBar" class="Search-searchBar" type="search" placeholder="Search..."><button style="width: 30px; height: 30px;" id="Global-searchBarBtn"></button>
        </div>
        {% render "components/filter.liquid", websites: collections.websites articleTypes: collections.articleTypes authors: collections.authors %}
        {% comment %} <div>
            <details class="Search-filterContainer Global-noSelect">
                <summary class="Search-filterContainerExpander">Filters</summary>

                <!-- website filters -->
                <hr/>
                <details class="Search-filterCategoryContainer Global-noSelect">
                    <summary>Websites</summary>
                    <div style="margin-top: 14px">
                        {% for website in collections.websites %}
                            <div class="ArticleFilters-checkboxContainer">
                                <input class="ArticleFilters-filterCheckbox ArticleFilters-filterCheckboxWebsites" type="checkbox" name="{{ website.name }}" checked />
                                <label class="ArticleFilters-filterCheckboxLabel" for="{{ website.name }}">{{ website.name }}</label>
                            </div>
                        {% endfor %}
                    </div>                    
                </details>

                
                <!-- article type filters -->
                <hr/>
                <details class="Search-filterCategoryContainer Global-noSelect">
                    <summary>Article Types</summary>
                    <div style="margin-top: 14px">
                        {% for articleType in collections.articleTypes %}
                            <div class="ArticleFilters-checkboxContainer">
                                <input class="ArticleFilters-filterCheckbox ArticleFilters-filterCheckboxWebsites" type="checkbox" name="{{ website.name }}" checked />
                                <label class="ArticleFilters-filterCheckboxLabel" for="{{ articleType.name }}">{{ articleType.name }}</label>
                            </div>
                        {% endfor %}
                    </div>                    
                </details>

                
                <!-- author filters -->
                <hr/>
                <details class="Search-filterCategoryContainer Global-noSelect">
                    <summary>Authors</summary>
                    <div style="margin-top: 14px">
                        <div>
                            <input style="height: 30px" id="Browse-filterInput" list="datalist-authors" type="search" placeholder="Add author filter..."><button style="width: 30px; height: 30px;" id="Browse-addFilter">&#43;</button>
                            <datalist id="datalist-authors">
                            {% for author in collections.authors -%}
                                <option value="{{ author.name }}" data-id="{{ author.id }}">{{ author.name }}</option>
                            {% endfor %}
                            </datalist>
                        </div>
                        
                    </div>                    
                </details>

                <hr/>
            </details>

        </div> {% endcomment %}
        
        <div id="Search-resultCount"></div> 
    </div>

    <!-- progress bar -->
    <div id="Search-progressBar" style="width: 80px; margin: auto;">
        {% render "components/progressBarCircle.liquid" %}
    </div>

    <!-- results -->
    <div id="Search-resultsContainer">
    </div>

    <!-- pager -->
     {% render "components/pager.liquid" %}
</div>
