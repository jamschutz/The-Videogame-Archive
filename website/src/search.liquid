---
title: Search
layout: 'base.liquid'
includeScript: /code/search.js
---

<div class="Search-container">
    <!-- search bar -->
    <div class="Search-header">
        <div style="display: flex;">
            <input style="height: 30px" id="Global-searchBar" class="Search-searchBar" type="search" placeholder="Search..."><button style="width: 30px; height: 30px;" id="Global-searchBarBtn"></button>
        </div>
        
        <div id="Search-resultCount"></div> 
    </div>

    <!-- progress bar -->
    <div id="Search-progressBar" style="width: 80px; margin: auto;">
        {% render "components/progressBarCircle.liquid" %}
    </div>

    <!-- results -->
    <div id="Search-resultsContainer">
    </div>

    <!-- pager -->
     {% render "components/pager.liquid" %}
</div>
