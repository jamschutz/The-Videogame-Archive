---
title: Home
layout: 'base.liquid'
includeScript: /code/index.js
---

<div class="Home-container">    
    <div>
        <input style="height: 30px" id="Global-searchBar" class="Search-searchBar" list="datalist-websites" type="search" placeholder="Search..."><button style="width: 30px; height: 30px;" id="Global-searchBarBtn"></button>
        <datalist id="datalist-websites">        
        {% for website in collections.websites -%}
            <option value="{{ website.name }}" data-id="{{ website.id }}">{{ website.name }}</option>
        {% endfor %}
        </datalist>
    </div>
    
    <div>
        <input style="height: 30px" id="Global-searchBar" class="Search-searchBar" list="datalist-authors" type="search" placeholder="Search..."><button style="width: 30px; height: 30px;" id="Global-searchBarBtn"></button>
        <datalist id="datalist-authors">        
        {% for author in collections.authors -%}
            <option value="{{ author.name }}">{{ author.name }}</option>
        {% endfor %}
        </datalist>
    </div>
</div>
