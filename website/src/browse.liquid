---
title: Home
layout: 'base.liquid'
includeScript: /code/browse.js
---

<div class="Browse-container">
    <div>
        <h2>Add filters:</h2>
    </div>
    <div>
        {% comment %} <span class="Browse-browseByLabel">Browse by: </span> {% endcomment %}
        <select id="Browse-includeExclude">
            <option value="include">Include</option>
            <option value="exclude">Exclude</option>
        </select>
        <select id="Browse-browseBySelect">
            <option value="website">Website</option>
            <option value="author">Author</option>
            <option value="articleType">Article Type</option>
        </select>
        <input style="height: 30px" id="Browse-filterInput" list="datalist-websites" type="search" placeholder="Search..."><button style="width: 30px; height: 30px;" id="Browse-addFilter">&#43;</button>



        {% comment  %} -------- DATA LISTS ----------------------- {% endcomment %}

        <datalist id="datalist-website">        
        {% for website in collections.websites -%}
            <option value="{{ website.name }}" data-id="{{ website.id }}">{{ website.name }}</option>
        {% endfor %}
        </datalist>
        
        <datalist id="datalist-articleType">        
        {% for type in collections.articleTypes -%}
            <option value="{{ type.name }}">{{ type.name }}</option>
        {% endfor %}
        </datalist>

        <datalist id="datalist-author">        
        {% for author in collections.authors -%}
            <option value="{{ author.name }}">{{ author.name }}</option>
        {% endfor %}
        </datalist>
    </div>
    <div id="Browse-filterCriteriaContainer">
        {% comment %} <div class="Browse-filterCriteria" id="Browse-criteria1">
            <button class="Browse-filterCriteriaDeleteBtn">❌</button><div class="Browse-filterCriteriaDescription"><b>include website</b>: Eurogamer</div>
        </div> {% endcomment %}
    </div>
</div>
