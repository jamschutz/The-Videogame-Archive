---
title: Home
layout: 'base.liquid'
includeScript: /code/browse.js
---

<div class="Browse-container">
    <div>
        <h2>Browse by filters:</h2>
    </div>
    {% comment %} <div> {% endcomment %}
        {% comment %} <span class="Browse-browseByLabel">Browse by: </span> {% endcomment %}
        {% comment %} <select id="Browse-includeExclude">
            <option value="include">Include</option>
            <option value="exclude">Exclude</option>
        </select>
        <select id="Browse-browseBySelect">
            <option value="websites">Website</option>
            <option value="authors">Author</option>
            <option value="articleTypes">Article Type</option>
        </select>
        <input style="height: 30px" id="Browse-filterInput" list="datalist-websites" type="search" placeholder="Search..."><button style="width: 30px; height: 30px;" id="Browse-addFilter">&#43;</button> {% endcomment %}



        {% comment  %} -------- DATA LISTS ----------------------- {% endcomment %}

        {% render "components/filter.liquid" websites: collections.websites articleTypes: collections.articleTypes %}

        {% comment %} <datalist id="datalist-websites">        
        {% for website in collections.websites -%}
            <option value="{{ website.name }}" data-id="{{ website.id }}">{{ website.name }}</option>
        {% endfor %}
        </datalist>
        
        <datalist id="datalist-articleTypes">        
        {% for type in collections.articleTypes -%}
            <option value="{{ type.name }}" data-id="{{ type.name }}">{{ type.name }}</option>
        {% endfor %}
        </datalist>

        <datalist id="datalist-authors">
        {% for author in collections.authors -%}
            <option value="{{ author.name }}" data-id="{{ author.id }}">{{ author.name }}</option>
        {% endfor %}
        </datalist>
    </div>
    <div id="Browse-filterCriteriaContainer">
    </div>{% endcomment %}
    <div class="Browse-submitBtnContainer">
        <button id="Browse-submitBtn">Submit</button> 
    </div>
</div>
