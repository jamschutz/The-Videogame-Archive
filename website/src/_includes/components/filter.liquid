<div>
    <details class="Filter-container Global-noSelect">
        <summary class="Filter-containerExpander">Filters</summary>

        <!-- website filters -->
        <hr/>
        <details class="Filter-categoryContainer Global-noSelect">
            <summary>Websites</summary>
            <div style="margin-top: 14px">
                {% for website in websites %}
                    <div class="ArticleFilters-checkboxContainer">
                        <input class="ArticleFilters-filterCheckbox ArticleFilters-filterCheckboxWebsites" type="checkbox" name="{{ website.name }}" checked />
                        <label class="ArticleFilters-filterCheckboxLabel" for="{{ website.name }}">{{ website.name }}</label>
                    </div>
                {% endfor %}
            </div>                    
        </details>

        
        <!-- article type filters -->
        <hr/>
        <details class="Filter-categoryContainer Global-noSelect">
            <summary>Article Types</summary>
            <div style="margin-top: 14px">
                {% for articleType in articleTypes %}
                    <div class="ArticleFilters-checkboxContainer">
                        <input class="ArticleFilters-filterCheckbox ArticleFilters-filterCheckboxWebsites" type="checkbox" name="{{ website.name }}" checked />
                        <label class="ArticleFilters-filterCheckboxLabel" for="{{ articleType.name }}">{{ articleType.name }}</label>
                    </div>
                {% endfor %}
            </div>                    
        </details>

        
        <!-- author filters -->
        <hr/>
        <details class="Filter-categoryContainer Global-noSelect">
            <summary>Authors</summary>
            <div style="margin-top: 14px">
                <div>
                    <input style="height: 30px" id="Browse-filterInput" list="datalist-authors" type="search" placeholder="Add author filter..."><button style="width: 30px; height: 30px;" id="Browse-addFilter">&#43;</button>
                    <datalist id="datalist-authors">
                    {% for author in authors -%}
                        <option value="{{ author.name }}" data-id="{{ author.id }}">{{ author.name }}</option>
                    {% endfor %}
                    </datalist>
                </div>                
            </div>                    
        </details>

        <hr/>
    </details>

</div>