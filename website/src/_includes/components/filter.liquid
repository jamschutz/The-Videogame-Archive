<div class="Filter-container Global-noSelect">
    <div class="Filter-containerExpander">Filters</div>

    <!-- website filters -->
    <hr/>
    <details class="Filter-categoryContainer Global-noSelect">
        <summary>Websites</summary>
        <div style="margin-top: 14px; display: block;">
            <!-- select all checkbox -->
            <div class="Filter-checkboxContainer">
                <input class="Filter-filterCheckbox" id="Filter-websiteSelectAll" type="checkbox" checked />
                <label class="Filter-selectAllLabel">Select all</label>
            </div>

            {% for website in websites %}
                <div class="Filter-checkboxContainer">
                    <input class="Filter-filterCheckbox Filter-filterCheckboxWebsites" type="checkbox" name="{{ website.name }}" checked />
                    <label class="Filter-filterCheckboxLabel" for="{{ website.name }}">{{ website.name }}</label>
                </div>
            {% endfor %}
        </div>                    
    </details>

    
    <!-- article type filters -->
    <hr/>
    <details class="Filter-categoryContainer Global-noSelect">
        <summary>Article Types</summary>
        <div style="margin-top: 14px; display: block;">
    
            <!-- select all checkbox -->
            <div class="Filter-checkboxContainer">
                <input class="Filter-filterCheckbox" id="Filter-articleTypeSelectAll" type="checkbox" checked />
                <label class="Filter-selectAllLabel">Select all</label>
            </div>

            {% for articleType in articleTypes %}
                <div class="Filter-checkboxContainer">
                    <input class="Filter-filterCheckbox Filter-filterCheckboxArticleTypes" type="checkbox" name="{{ articleType.name }}" checked />
                    <label class="Filter-filterCheckboxLabel" for="{{ articleType.name }}">{{ articleType.name }}</label>
                </div>
            {% endfor %}
        </div>                    
    </details>

    
    <!-- author filters -->
    <hr/>
    <details class="Filter-categoryContainer Global-noSelect">
        <summary>Authors</summary>
        <div style="margin-top: 14px; display: block;">
            <div style="display: flex; width: 99%;">
                <input style="height: 30px" id="Browse-filterInput" list="datalist-authors" type="search" placeholder="Add author filter..."><button style="width: 30px; height: 30px;" id="Browse-addFilter">&#43;</button>
                <datalist id="datalist-authors">
                {% for author in authors -%}
                    <option value="{{ author.name }}" data-id="{{ author.id }}">{{ author.name }}</option>
                {% endfor %}
                </datalist>
            </div>                
        </div>                    
    </details>

    <hr/>
</div>